{
  "name": "@foldjs/cli",
  "version": "0.3.1",
  "description": "Audit any website for foldable phones: finds elements under the hinge in book and tabletop postures, scores the page out of 100 and writes an HTML report with screenshots.",
  "license": "MIT",
  "author": "christophe77",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christophe77/fold.js.git",
    "directory": "packages/cli"
  },
  "homepage": "https://christophe77.github.io/fold.js/",
  "bugs": "https://github.com/christophe77/fold.js/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "foldjs-cli": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "foldable",
    "foldable-phone",
    "audit",
    "cli",
    "lighthouse",
    "accessibility",
    "responsive",
    "galaxy-fold",
    "pixel-fold",
    "hinge",
    "testing",
    "ci",
    "foldjs",
    "iphone-fold"
  ],
  "dependencies": {
    "foldjs": "^0.3.0",
    "puppeteer-core": "^23.11.1"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --target node18 --dts --clean --external foldjs --external puppeteer-core",
    "prepack": "node -e \"require('fs').copyFileSync('../../README.md','README.md')\""
  }
}
