{
  "name": "@foldjs/react",
  "version": "0.1.1",
  "description": "React hooks and components for foldable phones: useFold(), <TwoPane>, <FoldWhen> and a built-in foldable simulator. Works with Next.js.",
  "license": "MIT",
  "author": "christophe77",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christophe77/foldjs.git",
    "directory": "packages/react"
  },
  "homepage": "https://christophe77.github.io/foldjs/",
  "bugs": "https://github.com/christophe77/foldjs/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "keywords": [
    "react",
    "react-hooks",
    "react-component",
    "nextjs",
    "hooks",
    "foldable",
    "foldable-phone",
    "foldables",
    "dual-screen",
    "hinge",
    "viewport-segments",
    "device-posture",
    "galaxy-fold",
    "pixel-fold",
    "surface-duo",
    "two-pane",
    "responsive",
    "responsive-design",
    "layout",
    "tabletop-mode",
    "foldjs"
  ],
  "peerDependencies": {
    "foldjs": "^0.1.0",
    "react": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "node -e \"require('fs').copyFileSync('../../README.md','README.md')\""
  }
}
