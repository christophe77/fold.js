{
  "name": "foldjs",
  "version": "0.4.1",
  "description": "Make any web app foldable-ready: detect the hinge and posture (book, tabletop) of foldable phones and build two-pane layouts. Framework-agnostic core, CSS layer, Web Components and a built-in foldable simulator.",
  "license": "MIT",
  "author": "christophe77",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christophe77/fold.js.git",
    "directory": "packages/core"
  },
  "homepage": "https://christophe77.github.io/fold.js/",
  "bugs": "https://github.com/christophe77/fold.js/issues",
  "type": "module",
  "sideEffects": [
    "./dist/elements.js",
    "./dist/elements.cjs",
    "./dist/auto.global.js",
    "./dist/audit.global.js",
    "./css/fold.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./elements": {
      "types": "./dist/elements.d.ts",
      "import": "./dist/elements.js",
      "require": "./dist/elements.cjs"
    },
    "./devtools": {
      "types": "./dist/devtools.d.ts",
      "import": "./dist/devtools.js",
      "require": "./dist/devtools.cjs"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "import": "./dist/auto.js",
      "require": "./dist/auto.cjs"
    },
    "./auto.global.js": "./dist/auto.global.js",
    "./audit.global.js": "./dist/audit.global.js",
    "./css": "./css/fold.css"
  },
  "files": [
    "dist",
    "css",
    "bin"
  ],
  "keywords": [
    "javascript",
    "typescript",
    "web-components",
    "css",
    "angular",
    "astro",
    "simulator",
    "foldable",
    "foldable-phone",
    "foldables",
    "dual-screen",
    "hinge",
    "viewport-segments",
    "device-posture",
    "galaxy-fold",
    "pixel-fold",
    "surface-duo",
    "two-pane",
    "responsive",
    "responsive-design",
    "layout",
    "tabletop-mode",
    "foldjs",
    "iphone-fold"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "prepack": "node -e \"require('fs').copyFileSync('../../README.md','README.md')\""
  },
  "bin": {
    "foldjs": "bin/foldjs.js"
  }
}
