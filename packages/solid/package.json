{
  "name": "@foldjs/solid",
  "version": "0.2.0",
  "description": "SolidJS primitives for foldable phones: createFold() signal, use:twoPane directive and a built-in foldable simulator.",
  "license": "MIT",
  "author": "christophe77",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christophe77/foldjs.git",
    "directory": "packages/solid"
  },
  "homepage": "https://christophe77.github.io/foldjs/",
  "bugs": "https://github.com/christophe77/foldjs/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./dist/index.js",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "keywords": [
    "solid",
    "solidjs",
    "solid-js",
    "signals",
    "directive",
    "foldable",
    "foldable-phone",
    "foldables",
    "dual-screen",
    "hinge",
    "viewport-segments",
    "device-posture",
    "galaxy-fold",
    "pixel-fold",
    "surface-duo",
    "two-pane",
    "responsive",
    "responsive-design",
    "layout",
    "tabletop-mode",
    "foldjs"
  ],
  "peerDependencies": {
    "foldjs": "^0.2.0",
    "solid-js": "^1.6.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external solid-js --external foldjs",
    "prepack": "node -e \"require('fs').copyFileSync('../../README.md','README.md')\""
  }
}
