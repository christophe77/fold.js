{
  "name": "@foldjs/vue",
  "version": "0.3.0",
  "description": "Vue 3 composable and components for foldable phones: useFold(), <TwoPane>, <FoldWhen> and a built-in foldable simulator. Works with Nuxt.",
  "license": "MIT",
  "author": "christophe77",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christophe77/foldjs.git",
    "directory": "packages/vue"
  },
  "homepage": "https://christophe77.github.io/foldjs/",
  "bugs": "https://github.com/christophe77/foldjs/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "keywords": [
    "vue",
    "vue3",
    "vuejs",
    "composable",
    "nuxt",
    "foldable",
    "foldable-phone",
    "foldables",
    "dual-screen",
    "hinge",
    "viewport-segments",
    "device-posture",
    "galaxy-fold",
    "pixel-fold",
    "surface-duo",
    "two-pane",
    "responsive",
    "responsive-design",
    "layout",
    "tabletop-mode",
    "foldjs",
    "iphone-fold"
  ],
  "peerDependencies": {
    "foldjs": "^0.3.0",
    "vue": "^3.3.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external vue --external foldjs",
    "prepack": "node -e \"require('fs').copyFileSync('../../README.md','README.md')\""
  }
}
