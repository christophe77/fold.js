{
  "name": "@foldjs/svelte",
  "version": "0.4.1",
  "description": "Svelte store and actions for foldable phones: $fold, use:twoPane, use:foldWhen and a built-in foldable simulator. Works with SvelteKit.",
  "license": "MIT",
  "author": "christophe77",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christophe77/fold.js.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://christophe77.github.io/fold.js/",
  "bugs": "https://github.com/christophe77/fold.js/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "keywords": [
    "svelte",
    "sveltejs",
    "sveltekit",
    "svelte-action",
    "store",
    "foldable",
    "foldable-phone",
    "foldables",
    "dual-screen",
    "hinge",
    "viewport-segments",
    "device-posture",
    "galaxy-fold",
    "pixel-fold",
    "surface-duo",
    "two-pane",
    "responsive",
    "responsive-design",
    "layout",
    "tabletop-mode",
    "foldjs",
    "iphone-fold"
  ],
  "peerDependencies": {
    "foldjs": "^0.4.1",
    "svelte": ">=4"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external svelte --external foldjs",
    "prepack": "node -e \"require('fs').copyFileSync('../../README.md','README.md')\""
  }
}
