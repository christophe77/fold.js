{
  "name": "foldjs-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/react",
    "packages/vue",
    "packages/svelte",
    "packages/solid",
    "packages/cli",
    "apps/demo"
  ],
  "scripts": {
    "build": "npm run build -w foldjs && npm run build -w @foldjs/react -w @foldjs/vue -w @foldjs/svelte -w @foldjs/solid -w @foldjs/cli",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "npm run dev -w demo",
    "build:demo": "npm run build && npm run build -w demo"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "solid-js": "^1.9.3",
    "svelte": "^5.1.9",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "vue": "^3.5.12"
  }
}
